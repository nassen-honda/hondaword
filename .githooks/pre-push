#!/bin/sh
#
# main への push 時に本番（Xserver）へ rsync デプロイする pre-push フック
#
# 有効化（1回だけ）:
#   git config core.hooksPath .githooks
#   chmod +x .githooks/pre-push
#
# デプロイを飛ばして push だけしたい場合:
#   git push --no-verify
#
# なぜ GitHub Actions ではないのか:
#   XServer の SSH には「国外アクセス制限」が既定で ON になっており、
#   海外の IP で動く GitHub Actions のランナーは接続を弾かれるため。
#   国内 IP であるこの Mac から直接送るのが確実。
#
# 実装メモ:
#   read は EOF で非ゼロを返すときにも変数を空にしてしまう。
#   そのためループの外で使う値は、必ずループの中でフラグに落とすこと。
#   （local_sha をループの外で見ると常に空になる）
#

push_main=0
has_commits=0

while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "$_remote_ref" in
    refs/heads/main)
      push_main=1
      # sha が全て 0 ならブランチ削除の push
      case "$local_sha" in
        *[!0]*) has_commits=1 ;;
      esac
      ;;
  esac
done

# main 以外への push では何もしない
[ "$push_main" = "1" ] || exit 0

# ブランチ削除の push ではデプロイしない
[ "$has_commits" = "1" ] || exit 0

root=$(git rev-parse --show-toplevel)

echo "▶ main への push を検知 → 本番へデプロイします"
if sh "$root/deploy.sh"; then
  echo "✅ デプロイ成功。push を続行します。"
  exit 0
fi

echo ""
echo "❌ デプロイに失敗したため push を中止しました。"
echo "   （GitHub と本番がズレたままになるのを防ぐため）"
echo "   push だけ通したい場合: git push --no-verify"
exit 1
